# Line endings matter here, not just cosmetically: `tools/*.sh` is executed by
# bash on macOS and Linux, and a CRLF script fails with
# `/usr/bin/env: 'bash\r': No such file or directory` — which reads like a missing
# interpreter rather than a checkout problem.
* text=auto
*.sh   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.md   text eol=lf
*.swift text eol=lf
*.ps1  text eol=crlf

# The licence and notice texts are copied into consumers verbatim — tsdroid
# ships them in its APK and compares them byte-for-byte against this repository.
# `* text=auto` would give a Windows checkout CRLF and turn that comparison into
# a false alarm, so they are pinned here rather than left to `core.autocrlf`.
LICENSE-* text eol=lf
NOTICE    text eol=lf

# Binary artifacts whose bytes are the deliverable.
*.so   binary
*.dylib binary
*.dll  binary
*.lib  binary
*.exe  binary
