# Cargo
/target/
Cargo.lock.bak

# Build output: the shared libraries, the smoke-test executable and objects.
/out/
*.obj
*.o

# Swift
/.build/
/swift/.build/
# The XCFramework is a build artifact (see swift/Vendor/README.md); the directory
# itself stays so the `binaryTarget` path always exists.
/swift/Vendor/*.xcframework/
*.xcodeproj/
xcuserdata/

# Runtime data the library writes: a credential or a baseline in the tree is a
# leak waiting to happen, so they are ignored by name as well as by location.
account.json
myteamspeak-sync.json
*.json.tmp

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
